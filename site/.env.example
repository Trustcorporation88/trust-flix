# SocialFlow Site — variáveis de ambiente

# API — deixe VAZIO na Vercel (usa /api relativo). NÃO use localhost em produção.
NEXT_PUBLIC_API_URL=
NEXT_PUBLIC_JETBOT_API=
NEXT_PUBLIC_SITE_URL=https://www.socialflow.site

# Auth (obrigatório em produção)
JWT_SECRET=troque-por-um-segredo-longo-e-aleatorio
ADMIN_EMAIL=admin@socialflow.site
ADMIN_PASSWORD=troque-esta-senha-forte
ADMIN_NAME=Admin SocialFlow

# Cadastro público (em produção fica OFF por padrão)
ALLOW_REGISTER=false

# Postiz (instância Trust)
POSTIZ_API_URL=https://insta.trustcorp.com.br/api/public/v1
POSTIZ_API_KEY=

# Content Studio AI (server-side) — DeepSeek (barato). O Copilot NÃO usa isto como principal.
# Modelos vigentes: deepseek-v4-flash / deepseek-v4-pro.
# Os nomes `deepseek-chat` e `deepseek-reasoner` foram DESCONTINUADOS em 2026-07-24.
CONTENT_STUDIO_AI_PROVIDER=deepseek
CONTENT_STUDIO_AI_API_KEY=
CONTENT_STUDIO_AI_MODEL=deepseek-v4-flash

# Copilot AI — motor principal: Claude. Fallback: DeepSeek (chave do Content Studio).
# Providers aceitos: openai | anthropic | deepseek | google | groq | mistral | openrouter | custom
#
# Se COPILOT_AI_API_KEY estiver vazio, o Copilot usa ANTHROPIC_API_KEY como principal
# e CONTENT_STUDIO_AI_API_KEY (DeepSeek) como fallback.
COPILOT_AI_PROVIDER=anthropic
COPILOT_AI_API_KEY=
COPILOT_AI_MODEL=claude-3-5-sonnet-20241022
# Só para provider=custom (endpoint OpenAI-compatible)
COPILOT_AI_BASE_URL=

# Fallback quando o Claude falha (429 / 5xx). Padrão: DeepSeek do Content Studio.
# NÃO cobre busca web (gpt-5-search-api continua exclusivo da OpenAI).
#
# COPILOT_AI_FALLBACK_PROVIDER=deepseek
# COPILOT_AI_FALLBACK_API_KEY=
# COPILOT_AI_FALLBACK_MODEL=deepseek-v4-flash

# Claude (Copilot principal). Sem essa chave o Copilot cai no DeepSeek do Content Studio.
ANTHROPIC_API_KEY=
# COPILOT_ANTHROPIC_API_KEY=

# Instagram Graph (opcional) — enriquece o Copilot com Reels/Stories/mídias
# da conta business além do histórico do Postiz.
# A coleção "Salvos" (bookmarks) do app NÃO é exposta pela API business.
# INSTAGRAM_ACCESS_TOKEN=
# INSTAGRAM_BUSINESS_ACCOUNT_ID=
# COPILOT_DEFAULT_IG_HANDLE=cyntiarinaldidoces

# Pagamentos (opcional)
NEXT_PUBLIC_STRIPE_PUBLIC_KEY=
STRIPE_SECRET_KEY=
MERCADO_PAGO_ACCESS_TOKEN=
NEXT_PUBLIC_MERCADO_PAGO_PUBLIC_KEY=

# Analytics (opcional)
NEXT_PUBLIC_GA_ID=

NODE_ENV=development
